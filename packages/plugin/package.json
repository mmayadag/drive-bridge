{
	"name": "@drive-bridge/sdk",
	"version": "0.1.0",
	"private": true,
	"description": "Drive Bridge core and the SDK its bundled modules build on.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mmayadag/drive-bridge.git"
	},
	"files": [
		"./dist"
	],
	"type": "module",
	"sideEffects": false,
	"module": "./dist/index.js",
	"types": "./dist/index.spec.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.spec.d.ts",
			"default": "./dist/index.js"
		},
		"./dev": {
			"types": "./dist/dev.spec.d.ts",
			"default": "./dist/dev.js"
		}
	},
	"scripts": {
		"dev:plugin": "MODE=dev BUILD=plugin bun --bun tsdown",
		"build:plugin": "BUILD=plugin bun --bun tsdown",
		"dev": "MODE=dev PASS=dts bun --bun tsdown && MODE=dev bun --bun tsdown",
		"compile": "PASS=dts bun --bun tsdown && bun --bun tsdown",
		"fix": "oxlint --silent --fix && oxfmt",
		"check": "tsc && oxlint && oxfmt --check",
		"tests": "bun --preload=./test/mocks test"
	},
	"dependencies": {
		"obsidian": "^1.13.1"
	},
	"devDependencies": {
		"@repo/shared": "workspace:*",
		"@unocss/postcss": "^66.10.0",
		"postcss-merge-rules": "^9.0.3",
		"solid-js": "^1.9.15",
		"unocss": "^66.10.0",
		"unplugin-solid": "^2.0.0"
	}
}
